<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feeltens.git.mapper.SysUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.feeltens.git.entity.SysUserRoleDO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="role_code" property="roleCode"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT id, user_id, role_code, create_time
        FROM sys_user_role
        WHERE user_id = #{userId}
    </select>

    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT role_code
        FROM sys_user_role
        WHERE user_id = #{userId}
    </select>

    <insert id="batchInsert">
        INSERT INTO sys_user_role (user_id, role_code)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.roleCode})
        </foreach>
    </insert>

    <delete id="deleteByUserId">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

</mapper>